{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "RepoDiffPayload",
  "type": "object",
  "required": [
    "from",
    "instances",
    "manifest",
    "package",
    "relations",
    "summary",
    "to"
  ],
  "properties": {
    "from": {
      "type": "string"
    },
    "instances": {
      "$ref": "#/definitions/RepoDiffInstances"
    },
    "manifest": {
