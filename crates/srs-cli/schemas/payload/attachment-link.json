    "instanceId",
    "sourceRefsCount"
  ],
  "properties": {
    "documentId": {
      "type": "string"
    },
    "instanceId": {
      "type": "string"
    },
    "sourceRefsCount": {
      "type": "integer",
      "format": "uint",
