{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "RenderDocumentViewPayload",
  "type": "object",
  "required": [
    "diagnostics",
    "rendered"
  ],
  "properties": {
    "diagnostics": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "projection": {
      "anyOf": [
        {
          "$ref": "#/definitions/DocumentViewProjection"
        },
        {
          "type": "null"
        }
      ]
    },
    "rendered": {
      "type": "string"
    }
  },
  "definitions": {
    "DocumentViewProjection": {
      "description": "The top-level JSON projection object for a rendered document view.",
      "type": "object",
      "required": [
        "$schema",
        "containerTitle",
        "documentViewId",
        "generatedAt",
        "sections"
      ],
      "properties": {
        "$schema": {
          "type": "string"
        },
        "containerId": {
          "type": [
            "string",
            "null"
          ]
        },
        "containerTitle": {
          "type": "string"
        },
        "documentViewId": {
          "type": "string"
        },
        "generatedAt": {
          "type": "string"
        },
        "preamble": {
          "type": [
            "string",
            "null"
          ]
        },
        "sections": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/ProjectedSection"
          }
        }
      }
    },
    "ProjectedPropertyRow": {
      "description": "RFC-041 [R8] — one resolved `RecordPropertyView` row in the JSON projection, `{ property, label, value }`.",
      "type": "object",
      "required": [
        "label",
        "property",
        "value"
      ],
      "properties": {
        "label": {
          "type": "string"
        },
        "property": {
          "$ref": "#/definitions/ProjectedRecordProperty"
        },
        "value": {
          "$ref": "#/definitions/ProjectedPropertyValue"
        }
      }
    },
    "ProjectedPropertyValue": {
      "description": "A `RecordPropertyView` row's resolved value: `lifecycleState`/`createdAt`/ `updatedAt` are a single string, `tags` is a string array (RFC-041 Change C).",
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      ]
    },
    "ProjectedRecord": {
      "description": "A single record in a JSON projection section.",
      "type": "object",
      "required": [
        "fields",
        "instanceId",
        "orderedFieldKeys",
        "typeId",
        "typeName",
        "typeNamespace",
        "typeVersion"
      ],
      "properties": {
        "fields": {
          "description": "RFC-039 [R11]: keyed by Field.name; composites recurse under their key."
        },
        "instanceId": {
          "type": "string"
        },
        "orderedFieldKeys": {
          "description": "Field.name keys in FieldAssignment.order.",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "preamble": {
          "type": [
            "string",
            "null"
          ]
        },
        "properties": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "$ref": "#/definitions/ProjectedPropertyRow"
          }
        },
        "recordHeading": {
          "type": [
            "string",
            "null"
          ]
        },
        "relations": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "$ref": "#/definitions/ProjectedRelationRow"
          }
        },
        "typeId": {
          "type": "string"
        },
        "typeName": {
          "type": "string"
        },
        "typeNamespace": {
          "type": "string"
        },
        "typeVersion": {
          "description": "`Record.typeVersion` (RFC-032/RFC-039) — the authoritative half of the record-to-type PINNED binding alongside `typeId`.",
          "type": "integer",
          "format": "uint32",
          "minimum": 0.0
        }
      }
    },
    "ProjectedRecordProperty": {
      "description": "RFC-041 Change B — the closed vocabulary of top-level Record properties a `RecordPropertyView` row may present.",
      "type": "string",
      "enum": [
        "lifecycleState",
        "tags",
        "createdAt",
        "updatedAt"
      ]
    },
    "ProjectedRelationDirection": {
      "description": "Whether a `ProjectedRelationRow` presents the record as the source (`forward`) or target (`inverse`) of its listed edges (RFC-027).",
      "type": "string",
      "enum": [
        "forward",
        "inverse"
      ]
    },
    "ProjectedRelationRow": {
      "description": "A single labelled row of relation targets in a projected record's links block.",
      "type": "object",
      "required": [
        "direction",
        "label",
        "relationType",
        "targets"
      ],
      "properties": {
        "direction": {
          "$ref": "#/definitions/ProjectedRelationDirection"
        },
        "label": {
          "type": "string"
        },
        "relationType": {
          "type": "string"
        },
        "targets": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/ProjectedRelationTarget"
          }
        }
      }
    },
    "ProjectedRelationTarget": {
      "description": "A single target instance in a projected relation row.",
      "type": "object",
      "required": [
        "displayLabel",
        "instanceId"
      ],
      "properties": {
        "displayLabel": {
          "type": "string"
        },
        "instanceId": {
          "type": "string"
        }
      }
    },
    "ProjectedSection": {
      "description": "A single section in a JSON projection document.",
      "type": "object",
      "required": [
        "order",
        "records",
        "sectionId"
      ],
      "properties": {
        "order": {
          "type": "integer",
          "format": "int32"
        },
        "records": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/ProjectedRecord"
          }
        },
        "sectionId": {
          "type": "string"
        },
        "title": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    }
  }
}
