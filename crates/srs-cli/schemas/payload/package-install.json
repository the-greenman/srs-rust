{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "PackageInstallPayload",
  "type": "object",
  "required": [
    "boundaryPath",
    "conflicts",
    "installed",
    "installedAt",
    "kinds",
    "name",
    "namespace",
    "notes",
    "packageId",
    "skippedIdentical",
    "version"
  ],
  "properties": {
    "boundaryPath": {
      "description": "Boundary the package was installed into (or already registered at).",
      "type": "string"
    },
    "conflicts": {
      "description": "Same-key/different-UUID collisions (skipped, not silently duplicated).",
      "type": "array",
      "items": {
        "$ref": "#/definitions/PackageInstallConflictEntry"
      }
    },
    "diagnosticsStructured": {
      "description": "`notes` as structured findings, entry for entry (ADR-057, srs-rust#1339).",
      "type": "array",
      "items": {
        "$ref": "#/definitions/DiagnosticPayload"
      }
    },
    "installed": {
      "description": "Total definitions written by this run.",
      "type": "integer",
      "format": "uint",
      "minimum": 0.0
    },
    "installedAt": {
      "description": "Provenance stamp; preserved across idempotent re-runs.",
      "type": "string"
    },
    "kinds": {
      "description": "Per-kind breakdown for kinds present in the source package.",
      "type": "array",
      "items": {
        "$ref": "#/definitions/PackageInstallKindEntry"
      }
    },
    "name": {
      "type": "string"
    },
    "namespace": {
      "type": "string"
    },
    "notes": {
      "description": "Non-fatal `.srspkg` pre-load transformer notes (RFC-043 `migration-memberorder-dropped`, ...); always empty for a directory install.",
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "packageId": {
      "description": "Upstream package identity (provenance echo).",
      "type": "string"
    },
    "skippedIdentical": {
      "description": "Identical-UUID definitions skipped because they already exist in the repo.",
      "type": "integer",
      "format": "uint",
      "minimum": 0.0
    },
    "version": {
      "type": "string"
    }
  },
  "definitions": {
    "DiagnosticPayload": {
      "description": "One structured finding, beside the text `diagnostics` list on the render, find, container view, blueprint, navigation and type_schema surfaces (srs-rust#1491, ADR-057). Mirrors `diagnostic::Diagnostic`. `message` is the text-list entry verbatim.",
      "type": "object",
      "required": [
        "code",
        "message",
        "severity"
      ],
      "properties": {
        "code": {
          "description": "The stable rule identifier, in today's spelling.",
          "type": "string"
        },
        "instanceId": {
          "type": [
            "string",
            "null"
          ]
        },
        "message": {
          "type": "string"
        },
        "severity": {
          "$ref": "#/definitions/DiagnosticSeverityPayload"
        }
      }
    },
    "DiagnosticSeverityPayload": {
      "description": "Severity of a [`DiagnosticPayload`]. Mirrors `validation::DiagnosticSeverity`.",
      "type": "string",
      "enum": [
        "error",
        "warning",
        "info"
      ]
    },
    "PackageInstallConflictEntry": {
      "type": "object",
      "required": [
        "existingId",
        "key",
        "kind",
        "sourceId"
      ],
      "properties": {
        "existingId": {
          "type": "string"
        },
        "key": {
          "type": "string"
        },
        "kind": {
          "type": "string"
        },
        "sourceId": {
          "type": "string"
        }
      }
    },
    "PackageInstallKindEntry": {
      "type": "object",
      "required": [
        "conflicts",
        "installed",
        "kind",
        "skippedIdentical"
      ],
      "properties": {
        "conflicts": {
          "type": "integer",
          "format": "uint",
          "minimum": 0.0
        },
        "installed": {
          "type": "integer",
          "format": "uint",
          "minimum": 0.0
        },
        "kind": {
          "type": "string"
        },
        "skippedIdentical": {
          "type": "integer",
          "format": "uint",
          "minimum": 0.0
        }
      }
    }
  }
}
