        "documentId"
      ],
      "properties": {
        "contentChecksum": {
          "type": [
            "string",
            "null"
          ]
        },
        "contentPath": {
          "type": [
            "string",
            "null"
          ]
        },
        "documentId": {
          "type": "string"
        },
        "sidecarChecksum": {
          "type": [
            "string",
            "null"
          ]
        },
        "sidecarPath": {
          "type": [
            "string",
            "null"
          ]
        },
        "sizeBytes": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0.0
        },
        "title": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    }
  }
