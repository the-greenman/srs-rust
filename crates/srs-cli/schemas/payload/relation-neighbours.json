{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "NeighboursPayload",
  "description": "Payload for `relation neighbours` — a bounded page of an instance's edges, `total` before paging.",
  "type": "object",
  "required": [
    "result"
  ],
  "properties": {
    "result": {
      "$ref": "#/definitions/NeighboursResultPayload"
    }
  },
  "definitions": {
    "DiagnosticPayload": {
      "description": "One structured finding, beside the text `diagnostics` list on the render, find, container view, blueprint, navigation and type_schema surfaces (srs-rust#1491, ADR-057). Mirrors `diagnostic::Diagnostic`. `message` is the text-list entry verbatim.",
      "type": "object",
      "required": [
        "code",
        "message",
        "severity"
      ],
      "properties": {
        "code": {
          "description": "The stable rule identifier, in today's spelling.",
          "type": "string"
        },
        "instanceId": {
          "type": [
            "string",
            "null"
          ]
        },
        "message": {
          "type": "string"
        },
        "severity": {
          "$ref": "#/definitions/DiagnosticSeverityPayload"
        }
      }
    },
    "DiagnosticSeverityPayload": {
      "description": "Severity of a [`DiagnosticPayload`]. Mirrors `validation::DiagnosticSeverity`.",
      "type": "string",
      "enum": [
        "error",
        "warning",
        "info"
      ]
    },
    "EdgeDirectionPayload": {
      "description": "Mirrors `context_query_service::EdgeDirection`.",
      "type": "string",
      "enum": [
        "out",
        "in"
      ]
    },
    "NeighbourEdgePayload": {
      "description": "Mirrors `context_query_service::NeighbourEdge`.",
      "type": "object",
      "required": [
        "direction",
        "neighbour",
        "relationId",
        "relationType"
      ],
      "properties": {
        "direction": {
          "$ref": "#/definitions/EdgeDirectionPayload"
        },
        "neighbour": {
          "$ref": "#/definitions/NeighbourSummaryPayload"
        },
        "relationId": {
          "type": "string"
        },
        "relationType": {
          "type": "string"
        }
      }
    },
    "NeighbourSummaryPayload": {
      "description": "Mirrors `context_query_service::NeighbourSummary`.",
      "type": "object",
      "required": [
        "instanceId",
        "uri"
      ],
      "properties": {
        "instanceId": {
          "type": "string"
        },
        "label": {
          "type": [
            "string",
            "null"
          ]
        },
        "typeName": {
          "type": [
            "string",
            "null"
          ]
        },
        "typeNamespace": {
          "type": [
            "string",
            "null"
          ]
        },
        "uri": {
          "type": "string"
        }
      }
    },
    "NeighboursResultPayload": {
      "description": "Mirrors `context_query_service::NeighboursResult`.",
      "type": "object",
      "required": [
        "diagnostics",
        "diagnosticsStructured",
        "instanceId",
        "neighbours",
        "total"
      ],
      "properties": {
        "diagnostics": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "diagnosticsStructured": {
          "description": "The same findings as structured entries (ADR-057).",
          "type": "array",
          "items": {
            "$ref": "#/definitions/DiagnosticPayload"
          }
        },
        "instanceId": {
          "type": "string"
        },
        "neighbours": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/NeighbourEdgePayload"
          }
        },
        "total": {
          "type": "integer",
          "format": "uint",
          "minimum": 0.0
        }
      }
    }
  }
}
