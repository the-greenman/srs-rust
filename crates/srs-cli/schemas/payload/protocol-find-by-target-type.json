{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ProtocolFindByTargetTypePayload",
  "type": "object",
  "required": [
    "diagnostics",
    "diagnosticsStructured",
    "protocolId",
    "protocolName",
    "stages"
  ],
  "properties": {
    "diagnostics": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "diagnosticsStructured": {
      "description": "`diagnostics` as structured findings, entry for entry (ADR-057, srs-rust#1339).",
      "type": "array",
      "items": {
        "$ref": "#/definitions/DiagnosticPayload"
      }
    },
    "protocolId": {
      "type": "string"
    },
    "protocolName": {
      "type": "string"
    },
    "stages": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/ProtocolStageEntry"
      }
    }
  },
  "definitions": {
    "DiagnosticPayload": {
      "description": "One structured finding, beside the text `diagnostics` list on the render, find, container view, blueprint, navigation and type_schema surfaces (srs-rust#1491, ADR-057). Mirrors `diagnostic::Diagnostic`. `message` is the text-list entry verbatim.",
      "type": "object",
      "required": [
        "code",
        "message",
        "severity"
      ],
      "properties": {
        "code": {
          "description": "The stable rule identifier, in today's spelling.",
          "type": "string"
        },
        "instanceId": {
          "type": [
            "string",
            "null"
          ]
        },
        "message": {
          "type": "string"
        },
        "severity": {
          "$ref": "#/definitions/DiagnosticSeverityPayload"
        }
      }
    },
    "DiagnosticSeverityPayload": {
      "description": "Severity of a [`DiagnosticPayload`]. Mirrors `validation::DiagnosticSeverity`.",
      "type": "string",
      "enum": [
        "error",
        "warning",
        "info"
      ]
    },
    "FieldRef": {
      "description": "Payload mirror of `srs_core::types::protocol::FieldRef`. Separate struct because payload types must derive `JsonSchema`; srs-core must not depend on schemars (ADR-011).",
      "type": "object",
      "required": [
        "fieldId"
      ],
      "properties": {
        "fieldId": {
          "type": "string"
        },
        "typeId": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "ProtocolStageEntry": {
      "description": "A single entry in a protocol stages list.",
      "type": "object",
      "required": [
        "dependsOn",
        "name",
        "order",
        "stageId"
      ],
      "properties": {
        "aiGuidance": true,
        "completionCriteria": {
          "type": [
            "string",
            "null"
          ]
        },
        "contributesTo": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "$ref": "#/definitions/FieldRef"
          }
        },
        "dependsOn": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "name": {
          "type": "string"
        },
        "order": {
          "type": "integer",
          "format": "int32"
        },
        "outputType": {
          "type": [
            "string",
            "null"
          ]
        },
        "purpose": {
          "type": [
            "string",
            "null"
          ]
        },
        "question": {
          "type": [
            "string",
            "null"
          ]
        },
        "stageId": {
          "type": "string"
        }
      }
    }
  }
}
