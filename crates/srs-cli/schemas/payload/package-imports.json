  "required": [
    "blueprints",
    "fields",
    "generatedAt",
    "protocols",
    "relationTypes",
    "types",
    "views"
  ],
  "properties": {
    "blueprints": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/PackageImportRecordEntry"
      }
    },
    "diagnosticsStructured": {
      "description": "`skippedDefinitions` as structured findings, entry for entry (ADR-057, srs-rust#1339).",
      "type": "array",
      "items": {
        "$ref": "#/definitions/DiagnosticPayload"
      }
    },
    "fields": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/PackageImportRecordEntry"
      }
    },
    "generatedAt": {
      "type": "string"
    },
    "protocols": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/PackageImportRecordEntry"
      }
    },
    "relationTypes": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/PackageImportRecordEntry"
      }
    },
    "skippedDefinitions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "types": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/PackageImportRecordEntry"
      }
    },
    "views": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/PackageImportRecordEntry"
      }
    }
  },
  "definitions": {
    "DiagnosticPayload": {
      "description": "One structured finding, beside the text `diagnostics` list on the render, find, container view, blueprint, navigation and type_schema surfaces (srs-rust#1491, ADR-057). Mirrors `diagnostic::Diagnostic`. `message` is the text-list entry verbatim.",
      "type": "object",
      "required": [
        "code",
        "message",
        "severity"
      ],
      "properties": {
        "code": {
          "description": "The stable rule identifier, in today's spelling.",
          "type": "string"
        },
        "instanceId": {
          "type": [
            "string",
            "null"
          ]
        },
        "message": {
          "type": "string"
        },
        "severity": {
          "$ref": "#/definitions/DiagnosticSeverityPayload"
        }
      }
    },
    "DiagnosticSeverityPayload": {
      "description": "Severity of a [`DiagnosticPayload`]. Mirrors `validation::DiagnosticSeverity`.",
      "type": "string",
      "enum": [
        "error",
        "warning",
        "info"
      ]
    },
    "PackageImportRecordEntry": {
      "type": "object",
      "required": [
        "definitionId",
        "definitionType",
        "importedAt",
        "mode",
        "name",
        "namespace",
        "sourcePackageId",
        "sourcePackageName",
        "sourcePackageVersion",
        "version"
      ],
      "properties": {
        "conflictDetectedAt": {
          "type": [
            "string",
            "null"
          ]
        },
        "conflictState": {
          "type": [
            "string",
            "null"
          ]
        },
        "definitionId": {
          "type": "string"
        },
        "definitionType": {
          "type": "string"
        },
        "importedAt": {
          "type": "string"
        },
        "latestKnownUpstreamVersion": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0.0
        },
        "localEditedAt": {
          "type": [
            "string",
            "null"
          ]
        },
        "localVersion": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0.0
        },
        "mode": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "namespace": {
          "type": "string"
        },
        "sourcePackageId": {
          "type": "string"
        },
        "sourcePackageName": {
          "type": "string"
        },
        "sourcePackageVersion": {
          "type": "string"
        },
        "updateAvailable": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "updateCheckedAt": {
          "type": [
            "string",
            "null"
          ]
        },
        "version": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0.0
        }
      }
    }
  }
