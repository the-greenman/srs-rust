{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "RecordSuccessorPayload",
  "description": "Payload for `record successor` — the new Record and the Relation to the predecessor.",
  "type": "object",
  "required": [
    "record",
    "relation"
  ],
  "properties": {
    "record": {
      "$ref": "https://srs.semanticops.com/schema/2.0/record.json"
    },
    "relation": {
      "$ref": "https://srs.semanticops.com/schema/2.0/relation.json"
    }
  }
}
