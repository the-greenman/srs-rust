{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AttachmentPolicyPayload",
  "type": "object",
  "required": [
    "policyRecordPresent"
  ],
  "properties": {
    "allowedMimeTypes": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "type": "string"
      }
    },
    "maxDocBytes": {
      "type": [
        "integer",
        "null"
      ],
      "format": "uint64",
      "minimum": 0.0
    },
    "maxPerFileBytes": {
      "type": [
        "integer",
        "null"
      ],
      "format": "uint64",
      "minimum": 0.0
    },
    "maxTotalBytes": {
      "type": [
        "integer",
        "null"
      ],
      "format": "uint64",
      "minimum": 0.0
    },
    "policyRecordPresent": {
      "type": "boolean"
    }
  }
}
