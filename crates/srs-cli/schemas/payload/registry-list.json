{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "RegistryListPayload",
  "description": "Returned by `srs registry list` (RFC-049): the catalog fields (all optional), the entries that loaded and matched the filter, each with its `kind`, and the per-entry load outcomes ([R15]) of the entries that did not load.",
  "type": "object",
  "required": [
    "entries",
    "filteredCount",
    "outcomes",
    "registryRevision",
    "totalCount"
  ],
  "properties": {
    "catalogVersion": {
      "type": [
        "string",
        "null"
      ]
    },
    "entries": {
      "type": "array",
      "items": true
    },
    "filteredCount": {
      "type": "integer",
      "format": "uint",
      "minimum": 0.0
    },
    "homepage": {
      "type": [
        "string",
        "null"
      ]
    },
    "outcomes": {
      "type": "array",
      "items": true
    },
    "registryId": {
      "type": [
        "string",
        "null"
      ]
    },
    "registryName": {
      "type": [
        "string",
        "null"
      ]
    },
    "registryRevision": {
      "type": "integer",
      "format": "uint64",
      "minimum": 0.0
    },
    "totalCount": {
      "type": "integer",
      "format": "uint",
      "minimum": 0.0
    },
    "updatedAt": {
      "type": [
        "string",
        "null"
      ]
    }
  }
}
