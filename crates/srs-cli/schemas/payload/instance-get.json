{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "InstanceGetPayload",
  "description": "Payload for `instance get` — any instance read through one entry point, tagged by tier.\n\n`kind` is `\"note\"` (carries `note`) or `\"record\"` (carries `instanceId`, `displayLabel`, `record`, the same shape as `record get`).",
  "type": "object",
  "required": [
    "kind",
    "note",
    "record"
  ],
  "properties": {
    "displayLabel": {
      "type": [
        "string",
        "null"
      ]
    },
    "instanceId": {
      "type": [
        "string",
        "null"
      ]
    },
    "kind": {
      "type": "string"
    },
    "note": {
      "anyOf": [
        {
          "$ref": "https://srs.semanticops.com/schema/2.0/note.json"
        },
        {
          "type": "null"
        }
      ]
    },
    "record": {
      "anyOf": [
        {
          "$ref": "https://srs.semanticops.com/schema/2.0/record.json"
        },
        {
          "type": "null"
        }
      ]
    }
  }
}
