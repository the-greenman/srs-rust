{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "RepoMigrationsPayload",
  "type": "object",
  "required": [
    "migrations"
  ],
  "properties": {
    "migrations": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/MigrationSummaryPayload"
      }
    }
  },
  "definitions": {
    "MigrationStatusPayload": {
      "description": "Status of a migration for a specific repository. Contract: exactly one of the three booleans is `true`. This invariant is guaranteed by the `From<MigrationStatus>` impl below and must be preserved for any future `MigrationStatus` variant.",
      "type": "object",
      "required": [
        "alreadyApplied",
        "needed",
        "notApplicable"
      ],
      "properties": {
        "alreadyApplied": {
          "type": "boolean"
        },
        "needed": {
          "type": "boolean"
        },
        "notApplicable": {
          "type": "boolean"
        }
      }
    },
    "MigrationSummaryPayload": {
      "type": "object",
      "required": [
        "description",
        "id",
        "status",
        "title"
      ],
      "properties": {
        "description": {
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "revisionStep": {
          "description": "The data-model revision step this entry implements, or `null` for a structural entry. A `needed` entry with a step must be applied (in registry order) before writing.",
          "anyOf": [
            {
              "$ref": "#/definitions/RevisionStepPayload"
            },
            {
              "type": "null"
            }
          ]
        },
        "status": {
          "$ref": "#/definitions/MigrationStatusPayload"
        },
        "title": {
          "type": "string"
        }
      }
    },
    "RevisionStepPayload": {
      "type": "object",
      "required": [
        "from",
        "to"
      ],
      "properties": {
        "from": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0.0
        },
        "to": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0.0
        }
      }
    }
  }
}
