{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ContainerMembersMutatePayload",
  "type": "object",
  "required": [
    "containerId",
    "members",
    "promoted",
    "removed"
  ],
  "properties": {
    "containerId": {
      "type": "string"
    },
    "instanceId": {
      "description": "The entry the operation addressed (absent for `repair`).",
      "type": [
        "string",
        "null"
      ]
    },
    "members": {
      "type": "array",
      "items": true
    },
    "promoted": {
      "description": "Entries whose depth a promoting removal lowered ([R7]).",
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "removed": {
      "description": "Entries the operation removed.",
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
