{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "PackageExportPayload",
  "description": "`srs package export` (ADR-050): the written `.srspkg` and its summary.",
  "type": "object",
  "required": [
    "byteLength",
    "dataModelRevision",
    "definitionCount",
    "inlined",
    "kinds",
    "outputPath",
    "packageId",
    "packageName",
    "packageNamespace",
    "packageVersion",
    "publishedAt",
    "sha256"
  ],
  "properties": {
    "byteLength": {
      "type": "integer",
      "format": "uint",
      "minimum": 0.0
    },
    "dataModelRevision": {
      "description": "The `dataModelRevision` stamped into the bundle.",
      "type": "integer",
      "format": "uint64",
      "minimum": 0.0
    },
    "definitionCount": {
      "type": "integer",
      "format": "uint",
      "minimum": 0.0
    },
    "inlined": {
      "description": "Definition ids inlined from other boundaries by the closure (sorted).",
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "kinds": {
      "description": "Per-kind counts, install order, non-empty kinds only.",
      "type": "array",
      "items": {
        "$ref": "#/definitions/PackageExportKindEntry"
      }
    },
    "outputPath": {
      "description": "Path the `.srspkg` was written to.",
      "type": "string"
    },
    "packageId": {
      "type": "string"
    },
    "packageName": {
      "type": "string"
    },
    "packageNamespace": {
      "type": "string"
    },
    "packageVersion": {
      "type": "string"
    },
    "publishedAt": {
      "description": "The bundle's `publishedAt`; part of the bytes, so a reproducible sha256 needs a fixed `--published-at`.",
      "type": "string"
    },
    "sha256": {
      "description": "`sha256:<64 lowercase hex>` of the written file's bytes.",
      "type": "string"
    }
  },
  "definitions": {
    "PackageExportKindEntry": {
      "type": "object",
      "required": [
        "count",
        "kind"
      ],
      "properties": {
        "count": {
          "type": "integer",
          "format": "uint",
          "minimum": 0.0
        },
        "kind": {
          "type": "string"
        }
      }
    }
  }
}
