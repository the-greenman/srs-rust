{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "FederationEventsListPayload",
  "type": "object",
  "required": [
    "events",
    "filteredCount",
    "repositoryId",
    "totalCount"
  ],
  "properties": {
    "events": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/FederationEventPayload"
      }
    },
    "filteredCount": {
      "type": "integer",
      "format": "uint",
      "minimum": 0.0
    },
    "repositoryId": {
      "type": "string"
    },
    "totalCount": {
      "type": "integer",
      "format": "uint",
      "minimum": 0.0
    }
  },
  "definitions": {
    "FederationEventPayload": {
      "type": "object",
      "required": [
        "affectedInstanceIds",
        "at",
        "event",
        "eventId"
      ],
      "properties": {
        "affectedInstanceIds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "at": {
          "type": "string"
        },
        "event": {
          "type": "string"
        },
        "eventId": {
          "type": "string"
        },
        "note": {
          "type": [
            "string",
            "null"
          ]
        },
        "performedBy": {
          "type": [
            "string",
            "null"
          ]
        },
        "sourceRepositoryId": {
          "type": [
            "string",
            "null"
          ]
        },
        "strategy": {
          "type": [
            "string",
            "null"
          ]
        },
        "targetRepositoryId": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    }
  }
}
