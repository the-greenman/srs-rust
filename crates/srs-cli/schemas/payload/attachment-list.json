{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AttachmentListPayload",
  "type": "object",
  "required": [
    "entries",
    "sourceDocumentsPath"
  ],
  "properties": {
    "entries": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/AttachmentEntry"
      }
    },
    "sourceDocumentsPath": {
      "type": "string"
    }
  },
  "definitions": {
    "AttachmentEntry": {
      "type": "object",
      "required": [
        "path"
      ],
      "properties": {
        "contentChecksum": {
          "type": [
            "string",
            "null"
          ]
        },
        "documentId": {
          "type": [
            "string",
            "null"
          ]
        },
        "path": {
          "type": "string"
        },
        "sidecarChecksum": {
          "type": [
            "string",
            "null"
          ]
        },
        "title": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    }
  }
}
