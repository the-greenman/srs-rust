{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://srs.semanticops.com/schema/2.0/field.json",
  "title": "SRS Field Definition",
  "description": "An atomic, reusable field definition. Fields are the shared vocabulary of SRS — defined once, referenced across many Types.",
  "$comment": "RFC-033 frozen-seed fixed point: this hand-authored schema is the bootstrap base case, loaded as committed and never re-derived at runtime (a schema that defines Field cannot be parsed without the Field schema). Its record-level source is the com.semanticops.srs/metamodel package (the `field` Type + FieldType/ExactTypeRef/AiGuidance/AiGuidanceExample/Lineage/Provenance value-object Types); the #259 emitter regenerates this file from those records, and docs/schema/2.0/metamodel-fidelity.md declares which features round-trip authoritatively vs are approximated.",
  "type": "object",
  "required": [
    "id",
    "namespace",
    "name",
    "version",
    "description",
    "aiGuidance",
    "fieldType",
    "createdAt"
  ],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "id": {
      "type": "string",
      "format": "uuid"
    },
    "namespace": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "description": {
      "type": "string"
    },
    "instructions": {
      "type": "string"
    },
    "aiGuidance": {
      "$ref": "#/$defs/com.semanticops.srs__ai-guidance__v1",
      "title": "AI Guidance"
    },
    "fieldType": {
      "$ref": "#/$defs/com.semanticops.srs__field-type__v1",
      "title": "Field Type"
    },
    "editorHint": {
      "type": "string",
      "enum": [
        "singleline",
        "textarea",
        "rich-text",
        "date-picker",
        "dropdown",
        "multi-select",
        "voice"
      ],
      "title": "Editor Hint"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "lineage": {
      "$ref": "#/$defs/com.semanticops.srs__lineage__v1"
    },
    "provenance": {
      "$ref": "#/$defs/com.semanticops.srs__provenance__v1"
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    }
  },
  "$defs": {
    "com.semanticops.srs__ai-guidance__v1": {
      "type": "object",
      "required": [
        "purpose"
      ],
      "additionalProperties": false,
      "properties": {
        "purpose": {
          "type": "string"
        },
        "extraction": {
          "type": "string"
        },
        "negativeGuidance": {
          "type": "string",
          "title": "Negative Guidance"
        },
        "examples": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/com.semanticops.srs__ai-guidance-example__v1"
          }
        }
      }
    },
    "com.semanticops.srs__ai-guidance-example__v1": {
      "type": "object",
      "required": [
        "output"
      ],
      "additionalProperties": false,
      "properties": {
        "description": {
          "type": "string"
        },
        "input": {
          "type": "string"
        },
        "output": {
          "type": "string"
        }
      }
    },
    "com.semanticops.srs__field-type__v1": {
      "type": "object",
      "required": [
        "datatype"
      ],
      "additionalProperties": false,
      "description": "RFC-032 Change A — orthogonal type facets. Conditional requirements (R2/R3/R9/R10) are expressed in the allOf branches below; the full semantic conformance check (R1–R11) is scripts/lib/rfc-032-fieldtype.mjs::validateFieldType.",
      "properties": {
        "datatype": {
          "type": "string",
          "enum": [
            "string",
            "number",
            "integer",
            "boolean",
            "date",
            "date-time",
            "ref",
            "dependent",
            "map"
          ]
        },
        "cardinality": {
          "type": "string",
          "enum": [
            "single",
            "list"
          ]
        },
        "minItems": {
          "type": "integer",
          "minimum": 0,
          "title": "Min Items"
        },
        "maxItems": {
          "type": "integer",
          "minimum": 0,
          "title": "Max Items"
        },
        "valueDomain": {
          "type": "string",
          "enum": [
            "open",
            "closed"
          ],
          "title": "Value Domain"
        },
        "allowedValues": {
          "type": "array",
          "items": {
            "type": [
              "string",
              "integer"
            ]
          },
          "title": "Allowed Values"
        },
        "vocabularyRef": {
          "type": "string",
          "format": "uuid",
          "title": "Vocabulary Ref"
        },
        "format": {
          "type": "string",
          "enum": [
            "plain",
            "markdown",
            "uri",
            "uuid",
            "email"
          ]
        },
        "constraints": {
          "$ref": "#/$defs/com.semanticops.srs__field-type-constraints__v1"
        },
        "rangeType": {
          "$ref": "#/$defs/com.semanticops.srs__exact-type-ref__v1",
          "title": "Range Type"
        },
        "mode": {
          "type": "string",
          "enum": [
            "inline",
            "reference"
          ]
        },
        "dependsOn": {
          "type": "string",
          "title": "Depends On"
        },
        "valueRange": {
          "type": "string",
          "enum": [
            "string",
            "number",
            "integer",
            "boolean",
            "date",
            "date-time",
            "open",
            "ref"
          ],
          "title": "Value Range"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "datatype": {
                "const": "ref"
              }
            },
            "required": [
              "datatype"
            ]
          },
          "then": {
            "required": [
              "rangeType"
            ]
          },
          "else": {
            "not": {
              "anyOf": [
                {
                  "required": [
                    "rangeType"
                  ]
                },
                {
                  "required": [
                    "mode"
                  ]
                }
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "datatype": {
                "const": "dependent"
              }
            },
            "required": [
              "datatype"
            ]
          },
          "then": {
            "required": [
              "dependsOn"
            ]
          },
          "else": {
            "not": {
              "required": [
                "dependsOn"
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "datatype": {
                "const": "map"
              }
            },
            "required": [
              "datatype"
            ]
          },
          "then": {
            "required": [
              "valueRange"
            ]
          },
          "else": {
            "not": {
              "required": [
                "valueRange"
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "valueDomain": {
                "const": "closed"
              }
            },
            "required": [
              "valueDomain"
            ]
          },
          "then": {
            "oneOf": [
              {
                "required": [
                  "allowedValues"
                ],
                "not": {
                  "required": [
                    "vocabularyRef"
                  ]
                }
              },
              {
                "required": [
                  "vocabularyRef"
                ],
                "not": {
                  "required": [
                    "allowedValues"
                  ]
                }
              }
            ]
          }
        }
      ]
    },
    "com.semanticops.srs__field-type-constraints__v1": {
      "type": "object",
      "additionalProperties": false,
      "description": "Datatype-appropriate value constraints carried by a FieldType (RFC-032 Change F).",
      "properties": {
        "minLength": {
          "type": "integer",
          "minimum": 0,
          "title": "Min Length"
        },
        "maxLength": {
          "type": "integer",
          "minimum": 0,
          "title": "Max Length"
        },
        "pattern": {
          "type": "string"
        },
        "minimum": {
          "type": "number"
        },
        "maximum": {
          "type": "number"
        }
      }
    },
    "com.semanticops.srs__exact-type-ref__v1": {
      "type": "object",
      "required": [
        "typeId",
        "typeVersion"
      ],
      "additionalProperties": false,
      "description": "RFC-009 I-78. A version-exact reference to a Type in the Package (PINNED, rfc-decision-c8704763). Both typeId and typeVersion are required. The pre-RFC-009 version-optional Protocol TypeRef this once contrasted with is retired — Protocol.outputType is now a bare-UUID LINEAGE reference (typeVersion dropped; version-optional hybrids are forbidden).",
      "properties": {
        "typeId": {
          "type": "string",
          "format": "uuid",
          "title": "Type Id"
        },
        "typeVersion": {
          "type": "integer",
          "minimum": 1,
          "title": "Type Version"
        }
      }
    },
    "com.semanticops.srs__lineage__v1": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "sourceDefinitionId": {
          "type": "string",
          "format": "uuid",
          "title": "Source Definition Id"
        },
        "sourceVersion": {
          "type": "integer",
          "title": "Source Version"
        },
        "forkedFromDefinitionId": {
          "type": "string",
          "format": "uuid",
          "title": "Forked-From Definition Id"
        },
        "forkedFromVersion": {
          "type": "integer",
          "title": "Forked-From Version"
        }
      }
    },
    "com.semanticops.srs__provenance__v1": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "publisher": {
          "type": "string"
        },
        "sourcePackage": {
          "type": "string",
          "title": "Source Package"
        },
        "packageVersion": {
          "type": "string",
          "title": "Package Version"
        },
        "importedAt": {
          "type": "string",
          "format": "date-time",
          "title": "Imported At"
        }
      }
    }
  }
}
