{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://srs.semanticops.com/schema/2.0/relations-collection.json",
  "title": "SRS Relations Collection",
  "description": "Legacy relations collection — describes generation <= 1 (dataModelRevision <= 1) artifacts only. At dataModelRevision >= 2 a live repository or snapshot must not contain a relations-collection file (RFC-038 [R11]); each Relation is a standalone object at relations/<relationId>.json conforming to relation.json.",
  "type": "object",
  "required": [
    "relations"
  ],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "relations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Relation"
      }
    }
  },
  "$defs": {
    "Relation": {
      "type": "object",
      "required": [
        "relationId",
        "relationType",
        "sourceInstanceId",
        "targetInstanceId"
      ],
      "additionalProperties": false,
      "properties": {
        "relationId": {
          "type": "string",
          "format": "uuid"
        },
        "relationType": {
          "type": "string",
          "description": "Canonical types: contains, depends-on, supersedes, refines, derived-from, evidences, precedes. Custom types use namespace/name format."
        },
        "sourceInstanceId": {
          "type": "string",
          "format": "uuid",
          "description": "The asserting instance. Reads: source [relationType] target."
        },
        "targetInstanceId": {
          "type": "string",
          "format": "uuid",
          "description": "The related instance."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "notes": {
          "type": "string"
        },
        "sourceRefs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/SourceReference"
          }
        },
        "meta": {
          "type": "object"
        }
      }
    },
    "SourceReference": {
      "type": "object",
      "required": [
        "sourceType",
        "sourceId"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": { "sourceType": { "const": "repository-document" } },
            "required": ["sourceType"]
          },
          "then": {
            "properties": { "sourceId": { "format": "uuid" } }
          }
        }
      ],
      "properties": {
        "sourceType": {
          "type": "string",
          "enum": [
            "transcript-chunk",
            "transcript-segment",
            "external-document",
            "repository-document"
          ]
        },
        "sourceId": {
          "type": "string",
          "description": "Free-form when sourceType is transcript-chunk/transcript-segment/external-document. When sourceType is repository-document, MUST be a SourceDocument.documentId (format: uuid, RFC-017) — enforced by the sibling if/then."
        },
        "sourceStandard": {
          "type": "string"
        },
        "streamId": {
          "type": "string",
          "format": "uuid"
        },
        "sourceRole": {
          "type": "string",
          "enum": [
            "evidence",
            "extracted-from",
            "quoted-from",
            "inspired-by",
            "attaches"
          ],
          "description": "The role the source material plays for this instance (RFC-023). Replaces relationType. 'attaches' added by RFC-017: material attachment of a source document to a record (RFC-017 [R1])."
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "note": {
          "type": "string"
        }
      }
    }
  }
}
