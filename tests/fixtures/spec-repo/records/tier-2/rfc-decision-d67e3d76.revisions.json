      "recordId": "d67e3d76-cf55-47b8-a611-fe71cad41d2d",
      "fieldId": "5a000019-0000-4000-a000-000000000019",
      "value": "Field, Type, FieldAssignment, and the in-scope value objects are authored as SRS definitions in the canonical com.semanticops.srs/metamodel package, replacing RFC-004's parallel schema-source vocabulary.",
      "agent": {
        "type": "Ai"
      },
      "provenance": {
