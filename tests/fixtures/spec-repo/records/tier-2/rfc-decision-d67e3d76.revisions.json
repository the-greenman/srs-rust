      "recordId": "d67e3d76-cf55-47b8-a611-fe71cad41d2d",
      "fieldId": "5a000012-0000-4000-a000-000000000012",
      "value": "A second schema-source vocabulary would create two authorities for the same definitions. The canonical definition layer must use the Field and Type language it defines, with generated schemas retained as runtime projections.",
      "agent": {
        "type": "Ai"
      },
      "provenance": {
        "lifecycleTransition": "accepted",
        "transitionedAt": "2026-08-28T13:58:28.649702043+00:00"
      },
      "createdAt": "2026-08-28T13:58:28.649702043+00:00"
    },
    {
