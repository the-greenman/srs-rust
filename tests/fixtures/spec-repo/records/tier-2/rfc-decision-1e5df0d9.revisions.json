      "fieldId": "1a000001-0000-4000-a000-000000000001",
      "value": "Define the SRS decision-log inclusion boundary",
      "agent": {
        "type": "Ai"
      },
      "provenance": {
        "lifecycleTransition": "accepted",
        "transitionedAt": "2026-08-28T13:58:18.948441508+00:00"
      },
