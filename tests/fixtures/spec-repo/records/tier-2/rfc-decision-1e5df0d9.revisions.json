    },
    {
      "revisionId": "9204460a-ddcd-4bfa-8b98-15fc8c348bec",
      "recordId": "1e5df0d9-430f-4a5a-ae7a-b4cd21a7c72f",
      "fieldId": "5a000023-0000-4000-a000-000000000023",
      "value": "- Backfill every atomic research card, including mechanical derivations.\n- Treat tactical or operational work as sufficient reason to record a decision.\n- Record only RFC lifecycle outcomes, without reusable rationale or exceptions.\n- Leave the decision-log boundary implicit.",
      "agent": {
        "type": "Ai"
      },
      "provenance": {
        "lifecycleTransition": "accepted",
        "transitionedAt": "2026-08-28T13:58:18.948441508+00:00"
      },
      "createdAt": "2026-08-28T13:58:18.948441508+00:00"
    },
    {
      "revisionId": "24d3fe59-ea80-4e9d-a2b6-44110858ad7b",
      "recordId": "1e5df0d9-430f-4a5a-ae7a-b4cd21a7c72f",
      "fieldId": "5a000024-0000-4000-a000-000000000024",
      "value": "The project accepts a small amount of classification and review work before recording a decision. The log will not be a complete chronology of tasks, PRs, or research cards; a contributor must follow evidence links when exhaustive history is needed.",
      "agent": {
        "type": "Ai"
      },
      "provenance": {
        "lifecycleTransition": "accepted",
