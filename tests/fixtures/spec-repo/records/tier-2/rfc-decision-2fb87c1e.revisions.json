    {
      "revisionId": "eda480e3-2410-4e6f-acf3-ebc61a18756b",
      "recordId": "2fb87c1e-dc5f-442d-ade0-67ee71979627",
      "fieldId": "5a000012-0000-4000-a000-000000000012",
      "value": "An index can become stale or disagree with the stored objects it claims to enumerate. A common logical store-authority contract makes repository content coherent across backends while leaving each backend free to implement discovery.",
      "agent": {
        "type": "Ai"
      },
      "provenance": {
        "lifecycleTransition": "accepted",
        "transitionedAt": "2026-08-28T13:58:20.316982657+00:00"
      },
      "createdAt": "2026-08-28T13:58:20.316982657+00:00"
    },
    {
      "revisionId": "5767afb4-43ba-44fa-b695-d70548d13749",
      "recordId": "2fb87c1e-dc5f-442d-ade0-67ee71979627",
      "fieldId": "5a000019-0000-4000-a000-000000000019",
      "value": "A repository's authoritative content is what its authoritative store reports across the instance, relation, container, source-document, definition, and extension sets; manifest.json is not content authority except for its inline root container.",
      "agent": {
        "type": "Ai"
      },
      "provenance": {
        "lifecycleTransition": "accepted",
        "transitionedAt": "2026-08-28T13:58:20.316982657+00:00"
      },
      "createdAt": "2026-08-28T13:58:20.316982657+00:00"
    },
