      "fieldId": "5a000012-0000-4000-a000-000000000012",
      "value": "Composite renderer choice is a presentation arrangement, not a property of a Field or Type. View ownership permits multiple legitimate presentations of the same records while retaining a portable precedence contract.",
      "agent": {
        "type": "Ai"
      },
      "provenance": {
        "lifecycleTransition": "accepted",
        "transitionedAt": "2026-08-28T13:58:20.665951934+00:00"
