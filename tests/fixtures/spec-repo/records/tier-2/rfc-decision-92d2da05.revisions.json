      "fieldId": "1a000001-0000-4000-a000-000000000001",
      "value": "Rename DocumentView to Composition",
      "agent": {
        "type": "Ai"
      },
      "provenance": {
        "lifecycleTransition": "accepted",
        "transitionedAt": "2026-08-28T13:58:26.572630094+00:00"
