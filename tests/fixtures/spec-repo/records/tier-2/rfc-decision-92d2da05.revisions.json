    {
      "revisionId": "9da3dbf9-9abd-45b0-a577-db02558f89e6",
      "recordId": "92d2da05-4030-4afb-b8be-48ff8e9029d8",
      "fieldId": "5a000022-0000-4000-a000-000000000022",
      "value": "formation",
      "agent": {
        "type": "Ai"
      },
      "provenance": {
        "lifecycleTransition": "accepted",
