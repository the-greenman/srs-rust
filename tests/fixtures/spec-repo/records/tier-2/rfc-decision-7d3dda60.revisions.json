      "recordId": "7d3dda60-baf8-4204-a7c1-cb7287ca98ca",
      "fieldId": "5a000019-0000-4000-a000-000000000019",
      "value": "The revision-2 Record carrier will store fieldValues as an object keyed verbatim by Field.name, with field identity recovered through the Record's version-pinned Type rather than repeated as a fieldId in each value.",
      "agent": {
        "type": "Ai"
