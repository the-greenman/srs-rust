    },
    {
      "revisionId": "ab2bf67e-d915-454e-b550-1b83f765d3ec",
      "recordId": "92ac4529-261f-4e60-9434-7245ad2716be",
      "fieldId": "5a000026-0000-4000-a000-000000000026",
      "value": "The first full public release triggers the precommitted temporal reversal: `public-standard` replaces `formation`, and Continuity becomes the default. After that trigger, a breaking standard change requires an explicit version boundary, migration and compatibility analysis, recovery evidence, and owner ratification.",
      "agent": {
        "type": "Ai"
      },
